rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /laporan/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll([
                        'jenis', 'tipe', 'operator', 'kodeBarang', 'namaBarang',
                        'supplier', 'pemilik', 'lokasi', 'jumlah',
                        'tanggal', 'createdAt', 'updatedAt'
                      ])
                    && request.resource.data.jenis in ['masuk', 'keluar']
                    && request.resource.data.tipe in ['transaksi', 'penyesuaian']
                    && request.resource.data.operator is string
                    && request.resource.data.operator.size() > 0
                    && request.resource.data.operator.size() < 100
                    && request.resource.data.kodeBarang is string
                    && request.resource.data.namaBarang is string
                    && request.resource.data.lokasi is string
                    && request.resource.data.jumlah is number
                    && request.resource.data.jumlah > 0
                    && request.resource.data.jumlah < 1000000
                    && request.resource.data.tanggal is string
                    && request.resource.data.createdAt is number
                    && request.resource.data.updatedAt is number;
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['lokasi', 'jumlah', 'keterangan', 'updatedAt'])
                    && request.resource.data.lokasi is string
                    && request.resource.data.jumlah is number
                    && request.resource.data.jumlah > 0
                    && request.resource.data.jumlah < 1000000
                    && request.resource.data.updatedAt is number;
      allow delete: if request.auth != null;
    }

    // Koleksi barang baru — dipakai fitur "Barang tidak ada di daftar? Tambah
    // baru..." di form Tambah Laporan & Penyesuaian Stok. Hanya perlu
    // read (buat sinkronisasi realtime ke semua operator/admin) dan create
    // (nambah 1 item baru) — tidak ada fitur edit/hapus barang baru dari
    // sisi app, jadi update & delete sengaja tidak diizinkan.
    match /barangBaru/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['kode', 'nama', 'ditambahOleh', 'createdAt'])
                    && request.resource.data.kode is string
                    && request.resource.data.kode.size() > 0
                    && request.resource.data.kode.size() < 100
                    && request.resource.data.nama is string
                    && request.resource.data.nama.size() > 0
                    && request.resource.data.nama.size() < 200
                    && request.resource.data.ditambahOleh is string
                    && request.resource.data.createdAt is number;
      allow update, delete: if false;
    }

    // Koleksi pemilik baru — sama polanya dengan barangBaru, dipakai fitur
    // tambah "Pemilik Barang" baru di dropdown pemilik.
    match /pemilikBaru/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['nama', 'ditambahOleh', 'createdAt'])
                    && request.resource.data.nama is string
                    && request.resource.data.nama.size() > 0
                    && request.resource.data.nama.size() < 200
                    && request.resource.data.ditambahOleh is string
                    && request.resource.data.createdAt is number;
      allow update, delete: if false;
    }
    
    // Koleksi akun operator — dipakai fitur Daftar/Masuk operator.
    // read: perlu untuk cek nama sudah terdaftar (saat daftar), verifikasi
    //       password (saat login), dan daftar akun di panel admin.
    // create: dibuat sendiri oleh operator saat mendaftar.
    // update: tidak dipakai sama sekali oleh app — sengaja ditolak.
    // delete: dipakai admin untuk menghapus akun mencurigakan.
    match /operator/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll([
                        'nama', 'namaLower', 'idKaryawan', 'passwordHash', 'createdAt'
                      ])
                    && request.resource.data.nama is string
                    && request.resource.data.nama.size() > 0
                    && request.resource.data.nama.size() < 100
                    && request.resource.data.namaLower is string
                    && request.resource.data.namaLower.size() > 0
                    && request.resource.data.namaLower.size() < 100
                    && request.resource.data.idKaryawan is string
                    && request.resource.data.idKaryawan.size() > 0
                    && request.resource.data.idKaryawan.size() < 100
                    && request.resource.data.passwordHash is string
                    && request.resource.data.passwordHash.size() == 64
                    && request.resource.data.createdAt is number;
      allow update: if false;
      allow delete: if request.auth != null;
    }
    
    // Koleksi akun admin — dipakai fitur Daftar/Masuk admin ("Daftar Baru"
    // di layar login admin). Field & validasi sama persis dengan koleksi
    // operator, hanya beda nama koleksi.
    match /admin/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll([
                        'nama', 'namaLower', 'idKaryawan', 'passwordHash', 'createdAt'
                      ])
                    && request.resource.data.nama is string
                    && request.resource.data.nama.size() > 0
                    && request.resource.data.nama.size() < 100
                    && request.resource.data.namaLower is string
                    && request.resource.data.namaLower.size() > 0
                    && request.resource.data.namaLower.size() < 100
                    && request.resource.data.idKaryawan is string
                    && request.resource.data.idKaryawan.size() > 0
                    && request.resource.data.idKaryawan.size() < 100
                    && request.resource.data.passwordHash is string
                    && request.resource.data.passwordHash.size() == 64
                    && request.resource.data.createdAt is number;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
