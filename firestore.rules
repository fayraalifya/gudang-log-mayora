rules_version = '2';
// ==========================================================================
// PERUBAHAN PENTING (v3 — TANPA CLOUD FUNCTIONS):
//
// Project ini sengaja TETAP di plan Spark (tidak mau pakai billing/Blaze),
// jadi Cloud Functions (functions/index.js) TIDAK dipakai lagi. Ini
// mengubah cara role & kode akses pendaftaran diverifikasi dibanding versi
// sebelumnya (yang pakai custom claim + Admin SDK):
//
// 1. ROLE (operator/admin) sekarang ditentukan dari KOLEKSI tempat dokumen
//    profil user berada, dicek dengan exists() berdasarkan
//    request.auth.uid sebagai document ID (BUKAN NIK lagi — NIK cuma
//    field biasa di dalam dokumen, lihat idKaryawan). Ini menggantikan
//    custom claim `role` yang dulu diset lewat Cloud Function.
//
// 2. KODE AKSES PENDAFTARAN divalidasi DI SINI (dalam rules ini, lihat
//    konstanta KODE_AKSES_OPERATOR / KODE_AKSES_ADMIN di bawah), bukan di
//    Cloud Function lagi. Trik "registrationGate" dua-langkah: client
//    menulis dulu ke registrationGate/{uid} berisi kode yang diketik user
//    — create HANYA diizinkan kalau kodenya cocok. Baru kalau itu sukses,
//    client boleh menulis dokumen profil ke operator/{uid} atau
//    admin/{uid} (syaratnya exists(registrationGate/{uid})).
//    registrationGate TIDAK BISA dibaca siapa pun (allow read: if false)
//    supaya kode aksesnya tidak bisa dibaca balik lewat query Firestore.
//
//    PENTING — batasan yang harus disadari: karena ini bukan lagi rahasia
//    server (Cloud Function), siapa pun yang punya akses ke project
//    Firebase ini di Firebase Console (bukan pengunjung biasa aplikasi)
//    bisa membaca konstanta KODE_AKSES_* di rules ini. Ini trade-off yang
//    disengaja demi menghindari plan Blaze — kalau nanti mau upgrade ke
//    Blaze, sebaiknya balik pakai skema Cloud Function (lihat riwayat versi
//    file ini / functions/index.js) yang jauh lebih aman.
//
// 3. GANTI KODE AKSES: cukup edit dua konstanta di bawah lalu
//    `firebase deploy --only firestore:rules`. Tidak perlu secret/CLI
//    tambahan seperti versi Cloud Function.
//
// 4. "Hapus akun operator" oleh admin sekarang cuma hapus dokumen profil
//    (soft-delete, lihat rule delete di match /operator/{uid} di bawah) —
//    akun Firebase Auth-nya sendiri TIDAK ikut terhapus (client SDK cuma
//    bisa hapus akun sendiri, tidak bisa hapus akun user lain).
// ==========================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- GANTI DUA NILAI INI SESUAI KODE AKSES YANG DIPAKAI ----
    function kodeAksesOperator() {
      return "MAYORAGDPM2026";
    }
    function kodeAksesAdmin() {
      return "@ADMIN-MAYORAGDPM@";
    }

    function isSignedIn() {
      return request.auth != null;
    }
    function isOperator() {
      return isSignedIn() && exists(/databases/$(database)/documents/operator/$(request.auth.uid));
    }
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admin/$(request.auth.uid));
    }
    // Operator maupun admin sama-sama boleh baca/tulis data operasional
    // (laporan, katalog barang baru, dsb).
    function isAppUser() {
      return isOperator() || isAdmin();
    }

    match /laporan/{docId} {
      allow read: if isAppUser();
      allow create: if isAppUser()
                    && request.resource.data.keys().hasAll([
                        'jenis', 'tipe', 'operator', 'kodeBarang', 'namaBarang',
                        'supplier', 'pemilik', 'lokasi', 'jumlah',
                        'tanggal', 'createdAt', 'updatedAt'
                      ])
                    && request.resource.data.jenis in ['masuk', 'keluar']
                    && request.resource.data.tipe in ['transaksi', 'penyesuaian']
                    && request.resource.data.operator is string
                    && request.resource.data.operator.size() > 0
                    && request.resource.data.operator.size() < 100
                    && request.resource.data.kodeBarang is string
                    && request.resource.data.namaBarang is string
                    && request.resource.data.lokasi is string
                    && request.resource.data.jumlah is number
                    && request.resource.data.jumlah > 0
                    && request.resource.data.jumlah < 1000000
                    && request.resource.data.tanggal is string
                    && request.resource.data.createdAt is number
                    && request.resource.data.updatedAt is number;
      allow update: if isAppUser()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['lokasi', 'jumlah', 'keterangan', 'updatedAt'])
                    && request.resource.data.lokasi is string
                    && request.resource.data.jumlah is number
                    && request.resource.data.jumlah > 0
                    && request.resource.data.jumlah < 1000000
                    && request.resource.data.updatedAt is number;
      // Hapus laporan dibatasi admin saja — operator tidak butuh & tidak
      // seharusnya bisa menghapus riwayat laporan gudang.
      allow delete: if isAdmin();
    }

    match /barangBaru/{docId} {
      allow read: if isAppUser();
      allow create: if isAppUser()
                    && request.resource.data.keys().hasAll(['kode', 'nama', 'ditambahOleh', 'createdAt'])
                    && request.resource.data.kode is string
                    && request.resource.data.kode.size() > 0
                    && request.resource.data.kode.size() < 100
                    && request.resource.data.nama is string
                    && request.resource.data.nama.size() > 0
                    && request.resource.data.nama.size() < 200
                    && request.resource.data.ditambahOleh is string
                    && request.resource.data.createdAt is number;
      allow update, delete: if false;
    }

    match /pemilikBaru/{docId} {
      allow read: if isAppUser();
      allow create: if isAppUser()
                    && request.resource.data.keys().hasAll(['nama', 'ditambahOleh', 'createdAt'])
                    && request.resource.data.nama is string
                    && request.resource.data.nama.size() > 0
                    && request.resource.data.nama.size() < 200
                    && request.resource.data.ditambahOleh is string
                    && request.resource.data.createdAt is number;
      allow update, delete: if false;
    }

    // ---- Koleksi "gerbang" pendaftaran ----
    // Cuma dipakai sesaat saat pendaftaran untuk membuktikan client tahu
    // kode akses yang benar (lihat registerViaClientSDK() di script.js).
    // TIDAK PERNAH bisa dibaca oleh siapa pun, termasuk admin — supaya
    // kode akses yang tersimpan di sini tidak bisa dibaca balik.
    match /registrationGate/{uid} {
      allow read: if false;
      allow create: if isSignedIn()
                    && uid == request.auth.uid
                    && request.resource.data.role in ['operator', 'admin']
                    && (
                      (request.resource.data.role == 'operator' && request.resource.data.kodeAkses == kodeAksesOperator())
                      || (request.resource.data.role == 'admin' && request.resource.data.kodeAkses == kodeAksesAdmin())
                    );
      allow update, delete: if false;
    }

    // ---- Koleksi operator & admin ----
    // Document ID = UID Firebase Auth (BUKAN NIK lagi). Berisi profil
    // publik (nama, idKaryawan, createdAt, uid, role) — TIDAK ADA
    // password/hash sama sekali (password diverifikasi Firebase Auth
    // sendiri).
    match /operator/{uid} {
      allow read: if isAppUser();
      // Cuma boleh membuat profil untuk diri sendiri (uid harus sama
      // dengan yang lagi login), dan HARUS sudah lolos registrationGate
      // (bukti tahu kode akses operator) di request yang sama sesi.
      allow create: if isSignedIn()
                    && uid == request.auth.uid
                    && exists(/databases/$(database)/documents/registrationGate/$(uid))
                    && request.resource.data.keys().hasAll(['nama', 'idKaryawan', 'uid', 'role', 'createdAt'])
                    && request.resource.data.role == 'operator'
                    && request.resource.data.uid == uid
                    && request.resource.data.nama is string
                    && request.resource.data.nama.size() > 0
                    && request.resource.data.idKaryawan is string
                    && request.resource.data.idKaryawan.size() > 0
                    && request.resource.data.createdAt is number;
      // Admin bisa menghapus profil operator (soft-delete: langsung cabut
      // akses, walau akun Auth-nya sendiri tetap ada sampai dibersihkan
      // manual). Operator TIDAK bisa menghapus profilnya sendiri lewat
      // sini (kalau perlu, harus lewat fitur khusus / minta admin).
      allow delete: if isAdmin();
      allow update: if false;
    }
    match /admin/{uid} {
      allow read: if isAppUser();
      allow create: if isSignedIn()
                    && uid == request.auth.uid
                    && exists(/databases/$(database)/documents/registrationGate/$(uid))
                    && request.resource.data.keys().hasAll(['nama', 'idKaryawan', 'uid', 'role', 'createdAt'])
                    && request.resource.data.role == 'admin'
                    && request.resource.data.uid == uid
                    && request.resource.data.nama is string
                    && request.resource.data.nama.size() > 0
                    && request.resource.data.idKaryawan is string
                    && request.resource.data.idKaryawan.size() > 0
                    && request.resource.data.createdAt is number;
      // Admin lain boleh menghapus profil admin lain, TAPI tidak boleh
      // menghapus profilnya sendiri lewat sini (mencegah admin
      // ter-lockout total secara tidak sengaja kalau dia satu-satunya).
      allow delete: if isAdmin() && uid != request.auth.uid;
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
