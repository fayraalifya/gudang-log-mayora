rules_version = '2';
// ==========================================================================
// v3.3 — Perbaikan rule `update` pada koleksi `laporan`: v3.2 memperbaiki
// masalah field 'editLog'/'dihapus' tapi whitelist EDIT masih cuma
// ['lokasi','jumlah','keterangan','updatedAt','editLog'], padahal form Edit
// Riwayat (admin) di script.js sekarang mengirim update untuk field jauh
// lebih banyak: namaBarang, kodeBarang, supplier, pemilik, lokasi, tanggal,
// jumlah, qtyPerPallet, jumlahPallet, keterangan, updatedAt, editLog.
// Field di luar whitelist lama (namaBarang, kodeBarang, supplier, pemilik,
// tanggal, qtyPerPallet, jumlahPallet) membuat affectedKeys().hasOnly(...)
// selalu gagal, sehingga Edit Laporan SELALU ditolak dengan
// "Missing or insufficient permissions" walau tombolnya aktif di
// front-end — sementara soft-delete tetap jalan karena jalur itu memang
// cuma menyentuh 'dihapus'/'dihapusOleh'/'dihapusAt'.
//
// Perbaikan v3.3:
// - Whitelist EDIT diperluas mencakup semua field yang benar-benar dikirim
//   form Edit Riwayat.
// - qtyPerPallet & jumlahPallet boleh null (field opsional di form).
// - keterangan pakai request.resource.data.get('keterangan', '') supaya
//   tidak error kalau dokumen lama belum pernah punya field itu.
// - Jalur create, soft-delete, dan koleksi lain TIDAK diubah dari v3.2.
// ==========================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- GANTI DUA NILAI INI SESUAI KODE AKSES YANG DIPAKAI ----
    function kodeAksesOperator() {
      return "MAYORAGDPM2026";
    }
    function kodeAksesAdmin() {
      return "@ADMIN-MAYORAGDPM@";
    }

    function isSignedIn() {
      return request.auth != null;
    }
    function isOperator() {
      return isSignedIn() && exists(/databases/$(database)/documents/operator/$(request.auth.uid));
    }
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admin/$(request.auth.uid));
    }
    function isAppUser() {
      return isOperator() || isAdmin();
    }

    match /laporan/{docId} {
      allow read: if isAppUser();
      allow create: if isAppUser()
                    && request.resource.data.keys().hasAll([
                        'jenis', 'tipe', 'operator', 'kodeBarang', 'namaBarang',
                        'supplier', 'pemilik', 'lokasi', 'jumlah',
                        'tanggal', 'createdAt', 'updatedAt'
                      ])
                    && request.resource.data.jenis in ['masuk', 'keluar']
                    && request.resource.data.tipe in ['transaksi', 'penyesuaian']
                    && request.resource.data.operator is string
                    && request.resource.data.operator.size() > 0
                    && request.resource.data.operator.size() < 100
                    && request.resource.data.kodeBarang is string
                    && request.resource.data.namaBarang is string
                    && request.resource.data.lokasi is string
                    && request.resource.data.jumlah is number
                    && request.resource.data.jumlah > 0
                    && request.resource.data.jumlah < 1000000
                    && request.resource.data.tanggal is string
                    && request.resource.data.createdAt is number
                    && request.resource.data.updatedAt is number;
      allow update: if isAdmin()
                    && (
                      (
                        // ---- EDIT laporan (SEMUA field yang bisa diubah lewat form
                        //      Edit Riwayat di script.js, + jejak editLog) ----
                        request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly([
                              'namaBarang', 'kodeBarang', 'supplier', 'pemilik',
                              'lokasi', 'tanggal', 'jumlah', 'qtyPerPallet',
                              'jumlahPallet', 'keterangan', 'updatedAt', 'editLog'
                            ])
                        && request.resource.data.namaBarang is string
                        && request.resource.data.namaBarang.size() > 0
                        && request.resource.data.kodeBarang is string
                        && request.resource.data.kodeBarang.size() > 0
                        && request.resource.data.supplier is string
                        && request.resource.data.pemilik is string
                        && request.resource.data.lokasi is string
                        && request.resource.data.lokasi.size() > 0
                        && request.resource.data.tanggal is string
                        && request.resource.data.tanggal.size() > 0
                        && request.resource.data.jumlah is number
                        && request.resource.data.jumlah > 0
                        && request.resource.data.jumlah < 1000000
                        && (request.resource.data.get('qtyPerPallet', null) == null
                            || (request.resource.data.qtyPerPallet is number
                                && request.resource.data.qtyPerPallet > 0))
                        && (request.resource.data.get('jumlahPallet', null) == null
                            || request.resource.data.jumlahPallet is number)
                        && request.resource.data.get('keterangan', '') is string
                        && request.resource.data.updatedAt is number
                      )
                      ||
                      (
                        // ---- SOFT DELETE laporan (ditandai dihapus, dokumen tetap ada) ----
                        request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['dihapus', 'dihapusOleh', 'dihapusAt'])
                        && request.resource.data.dihapus is bool
                        && request.resource.data.dihapusOleh is string
                        && request.resource.data.dihapusOleh.size() > 0
                        && request.resource.data.dihapusAt is number
                      )
                    );
      allow delete: if isAdmin();
    }

    match /barangBaru/{docId} {
      allow read: if isAppUser();
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasAll(['kode', 'nama', 'ditambahOleh', 'createdAt'])
                    && request.resource.data.kode is string
                    && request.resource.data.kode.size() > 0
                    && request.resource.data.kode.size() < 100
                    && request.resource.data.nama is string
                    && request.resource.data.nama.size() > 0
                    && request.resource.data.nama.size() < 200
                    && request.resource.data.ditambahOleh is string
                    && request.resource.data.createdAt is number;
      allow update: if isAppUser()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['kode', 'nama', 'ditambahOleh', 'deleted'])
                    && (!('kode' in request.resource.data.diff(resource.data).affectedKeys())
                        || (request.resource.data.kode is string
                            && request.resource.data.kode.size() > 0
                            && request.resource.data.kode.size() < 100))
                    && (!('nama' in request.resource.data.diff(resource.data).affectedKeys())
                        || (request.resource.data.nama is string
                            && request.resource.data.nama.size() > 0
                            && request.resource.data.nama.size() < 200))
                    && (!('ditambahOleh' in request.resource.data.diff(resource.data).affectedKeys())
                        || (request.resource.data.ditambahOleh is string
                            && request.resource.data.ditambahOleh.size() > 0))
                    && (!('deleted' in request.resource.data.diff(resource.data).affectedKeys())
                        || request.resource.data.deleted is bool);
      allow delete: if isAdmin();
    }

    match /pemilikBaru/{docId} {
      allow read: if isAppUser();
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasAll(['nama', 'ditambahOleh', 'createdAt'])
                    && request.resource.data.nama is string
                    && request.resource.data.nama.size() > 0
                    && request.resource.data.nama.size() < 200
                    && request.resource.data.ditambahOleh is string
                    && request.resource.data.createdAt is number;
      allow update: if isAppUser()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['nama', 'ditambahOleh', 'deleted'])
                    && (!('nama' in request.resource.data.diff(resource.data).affectedKeys())
                        || (request.resource.data.nama is string
                            && request.resource.data.nama.size() > 0
                            && request.resource.data.nama.size() < 200))
                    && (!('ditambahOleh' in request.resource.data.diff(resource.data).affectedKeys())
                        || (request.resource.data.ditambahOleh is string
                            && request.resource.data.ditambahOleh.size() > 0))
                    && (!('deleted' in request.resource.data.diff(resource.data).affectedKeys())
                        || request.resource.data.deleted is bool);
      allow delete: if isAdmin();
    }

    match /supplierBaru/{docId} {
      allow read: if isAppUser();
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasAll(['nama', 'ditambahOleh', 'createdAt'])
                    && request.resource.data.nama is string
                    && request.resource.data.nama.size() > 0
                    && request.resource.data.nama.size() < 200
                    && request.resource.data.ditambahOleh is string
                    && request.resource.data.createdAt is number;
      allow update: if isAppUser()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['nama', 'ditambahOleh', 'deleted'])
                    && (!('nama' in request.resource.data.diff(resource.data).affectedKeys())
                        || (request.resource.data.nama is string
                            && request.resource.data.nama.size() > 0
                            && request.resource.data.nama.size() < 200))
                    && (!('ditambahOleh' in request.resource.data.diff(resource.data).affectedKeys())
                        || (request.resource.data.ditambahOleh is string
                            && request.resource.data.ditambahOleh.size() > 0))
                    && (!('deleted' in request.resource.data.diff(resource.data).affectedKeys())
                        || request.resource.data.deleted is bool);
      allow delete: if isAdmin();
    }

    match /lokasiBaru/{docId} {
      allow read: if isAppUser();
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasAll(['nama', 'ditambahOleh', 'createdAt'])
                    && request.resource.data.nama is string
                    && request.resource.data.nama.size() > 0
                    && request.resource.data.nama.size() < 200
                    && request.resource.data.ditambahOleh is string
                    && request.resource.data.createdAt is number;
      allow update: if isAppUser()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['nama', 'ditambahOleh', 'deleted'])
                    && (!('nama' in request.resource.data.diff(resource.data).affectedKeys())
                        || (request.resource.data.nama is string
                            && request.resource.data.nama.size() > 0
                            && request.resource.data.nama.size() < 200))
                    && (!('ditambahOleh' in request.resource.data.diff(resource.data).affectedKeys())
                        || (request.resource.data.ditambahOleh is string
                            && request.resource.data.ditambahOleh.size() > 0))
                    && (!('deleted' in request.resource.data.diff(resource.data).affectedKeys())
                        || request.resource.data.deleted is bool);
      allow delete: if isAdmin();
    }

    // ---- Koleksi "gerbang" pendaftaran ----
    match /registrationGate/{uid} {
      allow read: if false;
      allow create: if isSignedIn()
                    && uid == request.auth.uid
                    && request.resource.data.role in ['operator', 'admin']
                    && (
                      (request.resource.data.role == 'operator' && request.resource.data.kodeAkses == kodeAksesOperator())
                      || (request.resource.data.role == 'admin' && request.resource.data.kodeAkses == kodeAksesAdmin())
                    );
      allow update, delete: if false;
    }

    // ---- Koleksi operator & admin ----
    match /operator/{uid} {
      allow read: if isAppUser();
      allow create: if isSignedIn()
                    && uid == request.auth.uid
                    && exists(/databases/$(database)/documents/registrationGate/$(uid))
                    && request.resource.data.keys().hasAll(['nama', 'idKaryawan', 'uid', 'role', 'createdAt'])
                    && request.resource.data.role == 'operator'
                    && request.resource.data.uid == uid
                    && request.resource.data.nama is string
                    && request.resource.data.nama.size() > 0
                    && request.resource.data.idKaryawan is string
                    && request.resource.data.idKaryawan.size() > 0
                    && request.resource.data.createdAt is number;
      allow delete: if isAdmin();
      allow update: if false;
    }
    match /admin/{uid} {
      allow read: if isAppUser();
      allow create: if isSignedIn()
                    && uid == request.auth.uid
                    && exists(/databases/$(database)/documents/registrationGate/$(uid))
                    && request.resource.data.keys().hasAll(['nama', 'idKaryawan', 'uid', 'role', 'createdAt'])
                    && request.resource.data.role == 'admin'
                    && request.resource.data.uid == uid
                    && request.resource.data.nama is string
                    && request.resource.data.nama.size() > 0
                    && request.resource.data.idKaryawan is string
                    && request.resource.data.idKaryawan.size() > 0
                    && request.resource.data.createdAt is number;
      allow delete: if isAdmin() && uid != request.auth.uid;
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
